{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@brand-os/brand-core": ["packages/brand-core/src/index.ts"],
      "@brand-os/brand-core/assurance": ["packages/brand-core/src/assurance/index.ts"],
      "@brand-os/brand-core/assurance/workspace": ["packages/brand-core/src/assurance/local.ts"],
      "@brand-os/brand-core/coach": ["packages/brand-core/src/coach/index.ts"],
      "@brand-os/brand-core/competitive": ["packages/brand-core/src/competitive/index.ts"],
      "@brand-os/brand-core/content-bridge": ["packages/brand-core/src/content-bridge/index.ts"],
      "@brand-os/brand-core/identity": ["packages/brand-core/src/identity/index.ts"],
      "@brand-os/brand-core/creative": ["packages/brand-core/src/creative/index.ts"],
      "@brand-os/brand-core/research": ["packages/brand-core/src/research/index.ts"],
      "@brand-os/brand-core/runtime": ["packages/brand-core/src/runtime/index.ts"],
      "@brand-os/brand-core/seo": ["packages/brand-core/src/seo/index.ts"],
      "@brand-os/brand-core/strategy": ["packages/brand-core/src/strategy/index.ts"],
      "@brand-os/brand-core/visual": ["packages/brand-core/src/visual/index.ts"],
      "@brand-os/brand-core/visual-dna": ["packages/brand-core/src/visual-dna/index.ts"],
      "@brand-os/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@brand-os/asset-catalog": ["packages/asset-catalog/src/index.ts"],
      "@brand-os/asset-catalog/normalize": ["packages/asset-catalog/src/normalize.ts"],
      "@brand-os/asset-catalog/manage": ["packages/asset-catalog/src/manage.ts"]
    }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "apps/studio/**/*.ts"],
  "exclude": ["node_modules", "apps/docs", "**/dist/**"]
}
