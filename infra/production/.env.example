# Brand OS Studio production settings. Copy to /opt/brand-os-studio/.env, chmod 0600, owner root.
# Never commit the real file, paste it into a chat or issue, or print it in logs.
#
# Owner sign-in (login, password hash, TOTP secret, session secret) is NOT here: it lives in
# /opt/brand-os-studio/secrets/owner.env, written by `studio bootstrap-owner` (see DEPLOY.md).
# STUDIO_HOST, STUDIO_PORT, STUDIO_DATA_DIR and STUDIO_TRUST_PROXY are fixed in docker-compose.yml.

# ---- Image (Compose interpolation) --------------------------------------------------------------
# The reviewed commit: 12-character short SHA for the tag, full SHA for the image label.
STUDIO_IMAGE_TAG=
STUDIO_BUILD_REVISION=

# ---- Public origin ------------------------------------------------------------------------------
# Must be https beyond loopback. Used for the Origin/CSRF check, the Host allowlist and Secure cookies.
STUDIO_PUBLIC_ORIGIN=https://studio.omidataei.com

# ---- Sessions -----------------------------------------------------------------------------------
STUDIO_SESSION_HOURS=12
STUDIO_IDLE_MINUTES=60

# ---- GitHub: two separate least-privilege credentials ---------------------------------------------
# Read: fine-grained token limited to the brand repositories.
#   Repository permissions: Contents read, Metadata read, Pull requests read.
STUDIO_GITHUB_READ_TOKEN=
# Provision: used only by the New Brand wizard, limited to the allowlisted destination account.
#   Repository permissions: Administration read/write (create from template; delete a failed partial
#   repository), Contents read/write (the one initial commit), Metadata read; read access to the template.
#   Leave empty to disable brand creation (Studio stays a viewer).
STUDIO_GITHUB_PROVISION_TOKEN=
# Accounts/organizations Studio may create private repositories in (comma separated). Required with
# the provision token.
STUDIO_ALLOWED_OWNERS=
# The template new brands are generated from. It must be marked "Template repository" on GitHub.
STUDIO_TEMPLATE_REPO=omidlog/brand-os-template
# Optional push webhook secret (at least 20 characters). Without it Studio refreshes on view after the
# TTL and on Refresh. Generate with: openssl rand -hex 32
STUDIO_GITHUB_WEBHOOK_SECRET=
STUDIO_SYNC_TTL_SECONDS=300
# Periodic template check (see docs/template-sync.md). Minutes between runs, jittered; 0 turns it off.
STUDIO_TEMPLATE_CHECK_MINUTES=360
# 1 = the periodic check also opens at most one update pull request per brand that is behind (never merges).
# 0 (default) = check only and show "Updates available"; the owner opens pull requests by hand.
STUDIO_TEMPLATE_AUTO_PR=0
